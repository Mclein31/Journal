# ─────────────────────────────────────────────────────────────
# Dear Days — environment variables
# Production configuration. Keep actual values in the ignored .env file.
# Server-only secrets must NOT start with VITE_ (Vite exposes VITE_* to the browser).
# ─────────────────────────────────────────────────────────────

# ── Neon (Postgres database) ─────────────────────────────────
# Neon Console → your project → Dashboard → "Connect" button
# Select the production branch for BOTH connection strings.
# Pooled connection string (host contains "-pooler") — used by the API at runtime
DATABASE_URL=
# Direct (unpooled) connection string — used only for running migrations
DATABASE_URL_UNPOOLED=

# ── Cloudflare R2 (photo / sticker / background storage) ─────
# Cloudflare Dashboard → R2 → Manage R2 API Tokens → Create API token
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=journal-assets-prod
# S3 endpoint, format: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_S3_ENDPOINT=
# Keep the bucket PRIVATE (journals are personal). Images are served via signed URLs.

# ── Auth / sessions (login screen) ───────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Live HTTPS origin serving the API (no /api/auth suffix).
BETTER_AUTH_URL=https://dear-days.mcleinonza0531.workers.dev

# ── Email (sign-up verification + "forgot password") ───────
# Gmail SMTP: enable Google 2-Step Verification, then generate an App Password.
# See SMTP_SETUP.md. Configure these as server-only Worker runtime settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# Full Gmail address used to send verification/reset emails.
SMTP_USER=
# Google App Password (16 characters, without display spaces), not your login password.
SMTP_PASS=
# e.g. Dear Days <your-account@gmail.com>; use the same account as SMTP_USER.
EMAIL_FROM=

# ── App ──────────────────────────────────────────────────────
# Live HTTPS website origin, matching BETTER_AUTH_URL for the single-Worker setup.
APP_ORIGIN=https://dear-days.mcleinonza0531.workers.dev
# Safe to expose: the production API shares the website origin.
VITE_API_BASE_URL=/api
