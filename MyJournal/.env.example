# ─────────────────────────────────────────────────────────────
# My Little World — environment variables
# Fill in the values later. NEVER commit this file (.gitignore covers it).
# Server-only secrets must NOT start with VITE_ (Vite exposes VITE_* to the browser).
# ─────────────────────────────────────────────────────────────

# ── Neon (Postgres database) ─────────────────────────────────
# Neon Console → your project → Dashboard → "Connect" button
# Pooled connection string (host contains "-pooler") — used by the API at runtime
DATABASE_URL=
# Direct (unpooled) connection string — used only for running migrations
DATABASE_URL_UNPOOLED=

# ── Cloudflare R2 (photo / sticker / background storage) ─────
# Cloudflare Dashboard → R2 → Manage R2 API Tokens → Create API token
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# S3 endpoint, format: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_S3_ENDPOINT=
# Keep the bucket PRIVATE (journals are personal). Images are served via signed URLs.

# ── Auth / sessions (login screen) ───────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Where the API runs, e.g. http://localhost:8787 in dev
BETTER_AUTH_URL=

# ── Email (sign-up verification + "forgot password") ───────
# resend.com → API Keys. Verify your sending domain in Resend first.
RESEND_API_KEY=
# e.g. My Little World <hello@yourdomain.com>
EMAIL_FROM=

# ── App ──────────────────────────────────────────────────────
# Frontend origin allowed by the API (CORS), e.g. http://localhost:5173
APP_ORIGIN=
# Safe to expose: the API base URL the browser calls
VITE_API_BASE_URL=
