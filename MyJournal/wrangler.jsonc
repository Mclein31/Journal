{
  // Cloudflare Pages project: https://dear-days.pages.dev
  // dist/ = Vite build (static assets + _headers); functions/ = /api/* (Hono + Better Auth).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dear-days",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [{ "binding": "JOURNAL_FILES", "bucket_name": "journal-assets-prod" }],
  "vars": {
    "BETTER_AUTH_URL": "https://dear-days.pages.dev",
    "APP_ORIGIN": "https://dear-days.pages.dev",
    "SMTP_HOST": "smtp.gmail.com",
    "SMTP_PORT": "465",
    "SMTP_SECURE": "true"
  }
}
